# Storage and local HTTP server
RADAR_DATABASE_PATH=munich-events.db
RADAR_FEED_TOKEN=replace-with-a-long-random-token
RADAR_LISTEN_ADDRESS=127.0.0.1:8080
RADAR_SYNC_INTERVAL_MINUTES=360
RADAR_HTTP_TIMEOUT_SECONDS=20

# Optional discovery source. JSON format must be enabled in SearXNG.
RADAR_SEARXNG_URL=

# Optional Gemini/TAIA structured discovery. Set the full generateContent endpoint.
# Use RADAR_GEMINI_TOKEN for a proxy Bearer token, or RADAR_GEMINI_API_KEY for Google.
RADAR_GEMINI_ENDPOINT=
RADAR_GEMINI_MODEL=gemini-3.5-flash
RADAR_GEMINI_API_KEY=
RADAR_GEMINI_TOKEN=
RADAR_GEMINI_TIMEOUT_SECONDS=210

# Separate token for candidate moderation; never reuse RADAR_FEED_TOKEN.
RADAR_ADMIN_TOKEN=

# Disabled until an AI Tinkerers event was attended in the last 90 days.
RADAR_AI_TINKERERS_API_KEY=

# Optional notification delivery. `digest --dry-run` needs none of these.
RADAR_SMTP_HOST=smtp.mail.me.com:587
RADAR_SMTP_USERNAME=
RADAR_SMTP_PASSWORD=
RADAR_SMTP_FROM=
RADAR_DIGEST_RECIPIENT=
RADAR_NTFY_URL=
RADAR_NTFY_TOPIC=
