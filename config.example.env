# Core
RADAR_DATABASE_PATH=event-radar.db
RADAR_FEED_TOKEN=replace-with-a-long-random-token
RADAR_LISTEN_ADDRESS=127.0.0.1:8080
RADAR_SYNC_INTERVAL_MINUTES=360
RADAR_HTTP_TIMEOUT_SECONDS=20
RADAR_APP_NAME="Event Radar"
RADAR_CALENDAR_PRODID="-//Event Radar//Event Radar//EN"
RADAR_TIMEZONE=UTC

# Logging. Format is "text" or "json" (json suits Loki/Alloy); level is "debug", "info", "warn" or "error".
RADAR_LOG_FORMAT=text
RADAR_LOG_LEVEL=info

# Optional tracing (OTLP). Set to true and point OTEL_EXPORTER_OTLP_ENDPOINT at your OTLP receiver (e.g. Alloy, http://localhost:4318).
RADAR_TRACING_ENABLED=

# Anchored ICS feeds. Values are JSON arrays.
RADAR_ICS_FEEDS='[{"name":"community","url":"https://example.org/events.ics","anchor":true}]'
RADAR_LOCATION_ALIASES='[]'

# Optional discovery. Gemini is also the verifier for candidates.
RADAR_SEARXNG_URL=
RADAR_SEARXNG_QUERIES='[]'
RADAR_RELEVANCE_WEIGHTS='{"event":1}'
RADAR_EVENT_CRITERIA=
RADAR_GEMINI_ENDPOINT=
RADAR_GEMINI_API_KEY=
RADAR_GEMINI_TOKEN=
RADAR_GEMINI_TIMEOUT_SECONDS=210
RADAR_GEMINI_DISCOVERY_QUERIES='[]'

# Optional provider-specific source.
RADAR_AITINKERERS_API_KEY=
RADAR_AITINKERERS_QUERY=

# Optional candidate moderation.
RADAR_ADMIN_TOKEN=

# Optional OIDC login for the admin page (authorization-code flow with PKCE).
# Protects ONLY the admin routes; the calendar feed and probes stay token-free.
# At least one allowlist variable is required.
RADAR_OIDC_ISSUER=
RADAR_OIDC_CLIENT_ID=
RADAR_OIDC_CLIENT_SECRET=
RADAR_OIDC_REDIRECT_URL=
RADAR_OIDC_SCOPES=
RADAR_OIDC_ALLOWED_EMAILS=
RADAR_OIDC_ALLOWED_DOMAINS=
RADAR_OIDC_ALLOWED_SUBS=
# Set to true when behind an HTTPS reverse proxy that sends X-Forwarded-Proto;
# makes session cookies Secure.
RADAR_TRUST_PROXY=

# Optional email delivery.
RADAR_SMTP_HOST=
RADAR_SMTP_USERNAME=
RADAR_SMTP_PASSWORD=
RADAR_SMTP_FROM=
RADAR_DIGEST_RECIPIENT=
